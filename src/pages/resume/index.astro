---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkshopNav from "../../components/WorkshopNav.astro";
import ResumeContent from "../../components/ResumeContent.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout
  title="Resume"
  description="Work history, studies, skills — condensed for humans and hiring pipelines."
>
  <WorkshopNav currentPath={Astro.url.pathname} />

  <header class="section-hero">
    <span class="fig-label">DOC_001 · résumé</span>
    <h1>Resume</h1>
    <p class="meta-row">A concise map of where I've been and what I've built.</p>
  </header>

  <ResumeContent />

  <SiteFooter />
</BaseLayout>
