---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout title="Search" description="Search this site with Pagefind.">
  <SiteHeader currentPath={Astro.url.pathname} />

  <div class="frame section-lead">
    <p class="stamp">Recall buffer</p>
    <h1 style="margin: 0.35rem 0 0; border: none; padding: 0;">Search</h1>
    <p class="meta-row" style="margin: 0.35rem 0 0;">
      Index is generated by Pagefind during <code style="margin: 0 0.2rem;">npm run build</code>. In dev runs the box below stays idle until preview.
    </p>
  </div>

  {
    import.meta.env.DEV ? (
      <p class="meta-row">
        Run{" "}
        <code style="margin: 0 0.2rem;">npm run build && npm run preview</code>{" "}
        to exercise Pagefind offline.
      </p>
    ) : null
  }

  {!import.meta.env.DEV ? <div id="search" /> : null}

  <SiteFooter />

  {!import.meta.env.DEV ? (
    <>
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <script type="module" is:inline>
        import { PagefindUI } from "/pagefind/pagefind-ui.js";

        window.addEventListener("DOMContentLoaded", () => {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            resetStyles: false,
          });

          window.addEventListener("keydown", (e) => {
            const mac = e.metaKey && !e.ctrlKey;
            const win = e.ctrlKey;
            if (!(mac || win) || String(e.key).toLowerCase() !== "k") return;
            e.preventDefault();
            const inp = document.querySelector(
              '#search input[type="search"], #search input[type="text"]'
            );
            inp?.focus();
          });
        });
      </script>
    </>
  ) : null}
</BaseLayout>
