---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkshopNav from "../../components/WorkshopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout title="Search" description="Search this site with Pagefind.">
  <WorkshopNav currentPath={Astro.url.pathname} />

  <header class="section-hero">
    <h1>Search</h1>
    <p class="meta-row">
      Index is generated by Pagefind during <code style="margin: 0 0.2rem;">npm run build</code>. In dev runs the box below stays idle until preview.
    </p>
  </header>

  {
    import.meta.env.DEV ? (
      <p class="meta-row">
        Run{" "}
        <code style="margin: 0 0.2rem;">npm run build && npm run preview</code>{" "}
        to exercise Pagefind offline.
      </p>
    ) : null
  }

  {!import.meta.env.DEV ? (
    <div class="search-workbench">
      <span class="fig-label search-label">Query</span>
      <div id="search" />
    </div>
  ) : null}

  <SiteFooter />

  {!import.meta.env.DEV ? (
    <>
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <script type="module" is:inline>
        import { PagefindUI } from "/pagefind/pagefind-ui.js";

        window.addEventListener("DOMContentLoaded", () => {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            resetStyles: false,
          });

          window.addEventListener("keydown", (e) => {
            const mac = e.metaKey && !e.ctrlKey;
            const win = e.ctrlKey;
            if (!(mac || win) || String(e.key).toLowerCase() !== "k") return;
            e.preventDefault();
            const inp = document.querySelector(
              '#search input[type="search"], #search input[type="text"]'
            );
            inp?.focus();
          });
        });
      </script>
    </>
  ) : null}

  <style>
    .search-workbench {
      margin-bottom: 3rem;
    }

    .search-label {
      display: block;
      margin-bottom: 0.75rem;
    }

    #search {
      --pagefind-ui-scale: 1;
      --pagefind-ui-primary: var(--brand-green);
      --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--canvas);
      --pagefind-ui-border: var(--border-soft);
      --pagefind-ui-tag: var(--surface-mint);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--r-none);
      --pagefind-ui-image-border-radius: var(--r-none);
      --pagefind-ui-image-box-ratio: 16 / 10;
      --pagefind-ui-font: var(--font-body);
    }

    #search :global(.pagefind-ui__form) {
      position: relative;
    }

    #search :global(.pagefind-ui__search-input) {
      min-height: 64px;
      padding: 0 70px 0 54px;
      background-color: var(--canvas);
      
      border-radius: var(--r-none);
      font-family: var(--font-body);
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--ink);
      box-shadow: none;
      transition: border-color var(--duration-base) var(--ease-out-expo);
    border: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to right, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px, 100% 1px, 1px 100%, 1px 100%;
    background-position: top, bottom, left, right;
    background-repeat: no-repeat;
}

    #search :global(.pagefind-ui__search-input::placeholder) {
      color: var(--ink-subtle);
      opacity: 1;
    }

    #search :global(.pagefind-ui__search-input:focus) {
      outline: none;
      border-color: var(--ink);
      box-shadow: none;
    }

    #search :global(.pagefind-ui__search-clear) {
      right: 6px;
      height: calc(100% - 12px);
      padding: 0 1rem;
      background-color: var(--canvas);
      
      border-radius: var(--r-none);
      font-family: var(--font-sans);
      font-size: 16px;
      color: var(--ink);
      transition: color var(--duration-fast) var(--ease-out-expo),
        background-color var(--duration-fast) var(--ease-out-expo);
    border: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to right, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--border-soft) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px, 100% 1px, 1px 100%, 1px 100%;
    background-position: top, bottom, left, right;
    background-repeat: no-repeat;
}

    #search :global(.pagefind-ui__search-clear:hover) {
      color: var(--ink);
      background-color: var(--brand-green);
    }

    #search :global(.pagefind-ui__results) {
      display: grid;
      gap: 1rem;
      padding: 0;
      margin-top: 1.5rem;
    }

    #search :global(.pagefind-ui__result) {
      list-style: none;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;
      background-color: var(--canvas);
      
      border-radius: var(--r-none);
      box-shadow: none;
      transition: border-color var(--duration-base) var(--ease-out-expo);
    border: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px, 100% 1px, 1px 100%, 1px 100%;
    background-position: top, bottom, left, right;
    background-repeat: no-repeat;
}

    #search :global(.pagefind-ui__result:last-of-type) {
    border-bottom: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px;
    background-position: bottom;
    background-repeat: no-repeat;
}

    #search :global(.pagefind-ui__result:hover) {
      transform: none;
      border-color: var(--ink);
      box-shadow: none;
    }

    #search :global(.pagefind-ui__result-thumb) {
      flex-shrink: 0;
      width: 120px;
      margin: 0;
      aspect-ratio: var(--pagefind-ui-image-box-ratio);
      border-radius: var(--r-none);
      overflow: hidden;
      background-color: var(--canvas);
    border: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap))), repeating-linear-gradient(to bottom, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px, 100% 1px, 1px 100%, 1px 100%;
    background-position: top, bottom, left, right;
    background-repeat: no-repeat;
}

    #search :global(.pagefind-ui__result-image) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #search :global(.pagefind-ui__result-inner) {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin: 0;
    }

    #search :global(.pagefind-ui__result-title) {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 600;
      line-height: 1.2;
      text-transform: none;
      letter-spacing: 0;
      margin: 0;
    }

    #search :global(.pagefind-ui__result-link) {
      color: var(--ink);
      text-decoration: none;
      transition: color var(--duration-fast) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__result-link:hover) {
      color: var(--ink);
      background: var(--brand-green);
      text-decoration: none;
    }

    #search :global(.pagefind-ui__result-excerpt) {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--ink-muted);
      margin: 0;
      min-width: auto;
    }

    #search :global(.pagefind-ui__result-tags) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
      padding: 0;
    }

    #search :global(.pagefind-ui__result-tag) {
      font-family: var(--font-sans);
      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
      padding: 7px 12px;
      color: var(--ink);
      background: var(--surface-soft);
      border: none;
      border-radius: var(--r-pill);
    }

    #search :global(.pagefind-ui__result-nested) {
      padding-left: 1rem;
      border-left: 3px solid var(--brand-green);
      margin-top: 0.75rem;
    }

    #search :global(.pagefind-ui__result-nested .pagefind-ui__result-link) {
      font-family: var(--font-sans);
      font-size: 16px;
      color: var(--ink);
    }

    #search :global(.pagefind-ui__message) {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink-muted);
      padding: 1rem 0;
      margin: 0;
      height: auto;
    }

    #search :global(.pagefind-ui__button) {
      min-height: 48px;
      margin-top: 1.5rem;
      padding: 7px 12px;
      font-family: var(--font-sans);
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--on-primary);
      background: var(--primary);
      border: 1px solid var(--primary);
      border-radius: var(--r-none);
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-out-expo),
        border-color var(--duration-fast) var(--ease-out-expo),
        background-color var(--duration-fast) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__button:hover) {
      color: var(--ink);
      border-color: var(--ink);
      background-color: var(--brand-green);
    }

    @media (prefers-reduced-motion: reduce) {
      #search :global(.pagefind-ui__search-input),
      #search :global(.pagefind-ui__search-clear),
      #search :global(.pagefind-ui__result),
      #search :global(.pagefind-ui__result-link),
      #search :global(.pagefind-ui__button) {
        transition: none;
      }

      #search :global(.pagefind-ui__result:hover) {
        transform: none;
      }
    }

    @media (max-width: 640px) {
      #search :global(.pagefind-ui__result) {
        flex-direction: column;
        gap: 0.75rem;
      }

      #search :global(.pagefind-ui__result-thumb) {
        width: 100%;
        max-width: 160px;
      }
    }
  </style>
</BaseLayout>
