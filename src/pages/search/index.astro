---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkshopNav from "../../components/WorkshopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout title="Search" description="Search this site with Pagefind.">
  <WorkshopNav currentPath={Astro.url.pathname} />

  <header class="section-hero">
    <span class="fig-label">SRC_001 · search index</span>
    <h1>Search</h1>
    <p class="meta-row">
      Index is generated by Pagefind during <code style="margin: 0 0.2rem;">npm run build</code>. In dev runs the box below stays idle until preview.
    </p>
  </header>

  {
    import.meta.env.DEV ? (
      <p class="meta-row">
        Run{" "}
        <code style="margin: 0 0.2rem;">npm run build && npm run preview</code>{" "}
        to exercise Pagefind offline.
      </p>
    ) : null
  }

  {!import.meta.env.DEV ? (
    <div class="search-workbench">
      <span class="fig-label search-label">Query</span>
      <div id="search" />
    </div>
  ) : null}

  <SiteFooter />

  {!import.meta.env.DEV ? (
    <>
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <script type="module" is:inline>
        import { PagefindUI } from "/pagefind/pagefind-ui.js";

        window.addEventListener("DOMContentLoaded", () => {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            resetStyles: false,
          });

          window.addEventListener("keydown", (e) => {
            const mac = e.metaKey && !e.ctrlKey;
            const win = e.ctrlKey;
            if (!(mac || win) || String(e.key).toLowerCase() !== "k") return;
            e.preventDefault();
            const inp = document.querySelector(
              '#search input[type="search"], #search input[type="text"]'
            );
            inp?.focus();
          });
        });
      </script>
    </>
  ) : null}

  <style>
    .search-workbench {
      margin-bottom: 3rem;
    }

    .search-label {
      display: block;
      margin-bottom: 0.75rem;
    }

    #search {
      --pagefind-ui-scale: 1;
      --pagefind-ui-primary: var(--accent);
      --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--canvas-elevated);
      --pagefind-ui-border: var(--line-strong);
      --pagefind-ui-tag: var(--accent-soft);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--radius-md);
      --pagefind-ui-image-border-radius: var(--radius-md);
      --pagefind-ui-image-box-ratio: 16 / 10;
      --pagefind-ui-font: var(--font-body);
    }

    #search :global(.pagefind-ui__form) {
      position: relative;
    }

    #search :global(.pagefind-ui__search-input) {
      min-height: 64px;
      padding: 0 70px 0 54px;
      background: var(--canvas-elevated);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--ink);
      box-shadow: var(--shadow-sm);
      transition: border-color var(--duration-base) var(--ease-out-expo),
        box-shadow var(--duration-base) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__search-input::placeholder) {
      color: var(--ink-subtle);
      opacity: 1;
    }

    #search :global(.pagefind-ui__search-input:focus) {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow-sm);
    }

    #search :global(.pagefind-ui__search-clear) {
      right: 6px;
      height: calc(100% - 12px);
      padding: 0 1rem;
      background: transparent;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-muted);
      transition: color var(--duration-fast) var(--ease-out-expo),
        background-color var(--duration-fast) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__search-clear:hover) {
      color: var(--accent);
      background-color: var(--accent-soft);
    }

    #search :global(.pagefind-ui__results) {
      display: grid;
      gap: 1rem;
      padding: 0;
      margin-top: 1.5rem;
    }

    #search :global(.pagefind-ui__result) {
      list-style: none;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;
      background: var(--canvas-elevated);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      transition: transform var(--duration-base) var(--ease-out-expo),
        border-color var(--duration-base) var(--ease-out-expo),
        box-shadow var(--duration-base) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__result:last-of-type) {
      border-bottom: 1px solid var(--line);
    }

    #search :global(.pagefind-ui__result:hover) {
      transform: translateY(-4px);
      border-color: var(--accent-soft);
      box-shadow: var(--shadow-md);
    }

    #search :global(.pagefind-ui__result-thumb) {
      flex-shrink: 0;
      width: 120px;
      margin: 0;
      aspect-ratio: var(--pagefind-ui-image-box-ratio);
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--canvas);
      border: 1px solid var(--line);
    }

    #search :global(.pagefind-ui__result-image) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #search :global(.pagefind-ui__result-inner) {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin: 0;
    }

    #search :global(.pagefind-ui__result-title) {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 600;
      line-height: 1.2;
      text-transform: none;
      letter-spacing: 0;
      margin: 0;
    }

    #search :global(.pagefind-ui__result-link) {
      color: var(--ink);
      text-decoration: none;
      transition: color var(--duration-fast) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__result-link:hover) {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: var(--accent-soft);
      text-underline-offset: 3px;
    }

    #search :global(.pagefind-ui__result-excerpt) {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--ink-muted);
      margin: 0;
      min-width: auto;
    }

    #search :global(.pagefind-ui__result-tags) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
      padding: 0;
    }

    #search :global(.pagefind-ui__result-tag) {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.15rem 0.4rem;
      color: var(--ink-muted);
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 1px;
    }

    #search :global(.pagefind-ui__result-nested) {
      padding-left: 1rem;
      border-left: 2px solid var(--line);
      margin-top: 0.75rem;
    }

    #search :global(.pagefind-ui__result-nested .pagefind-ui__result-link) {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent-hot);
    }

    #search :global(.pagefind-ui__message) {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--ink-muted);
      padding: 1rem 0;
      margin: 0;
      height: auto;
    }

    #search :global(.pagefind-ui__button) {
      min-height: 48px;
      margin-top: 1.5rem;
      padding: 0 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink);
      background: var(--canvas-elevated);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-out-expo),
        border-color var(--duration-fast) var(--ease-out-expo),
        background-color var(--duration-fast) var(--ease-out-expo);
    }

    #search :global(.pagefind-ui__button:hover) {
      color: var(--accent);
      border-color: var(--accent);
      background-color: var(--accent-soft);
    }

    @media (max-width: 640px) {
      #search :global(.pagefind-ui__result) {
        flex-direction: column;
        gap: 0.75rem;
      }

      #search :global(.pagefind-ui__result-thumb) {
        width: 100%;
        max-width: 160px;
      }
    }
  </style>
</BaseLayout>
