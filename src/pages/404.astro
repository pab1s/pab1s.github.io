---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="404 — off the map" description="No fixture at this coordinate.">
  <SiteHeader currentPath={Astro.url.pathname} />

  <div class="frame" style="text-align: center; padding: 1.1rem 0.75rem;">
    <p class="stamp">Signal lost</p>
    <h1 style="margin: 0.55rem 0; border: none; padding: 0;">404</h1>
    <p class="meta-row">This bearing does not resolve to a published sheet.</p>
    <p style="margin-top: 0.85rem;">
      <a href="/">Return to mission brief</a>
    </p>
  </div>

  <SiteFooter />
</BaseLayout>
