---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkshopNav from "../../../components/WorkshopNav.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../../site-config";
import { formatDate } from "../../../lib/date";
import { calculateReadTime } from "../../../lib/reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const published = posts.filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return published.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, index },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  index: number;
}

const { post, index } = Astro.props;
const { Content, headings } = await render(post);

const desc = post.data.description?.trim() || siteConfig.description;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

// Calculate read time (rough estimate: 200 words per minute)
const readTime = calculateReadTime(post.body);

// Adjacent posts
const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const prevPost = allPosts[index + 1] || null;
const nextPost = allPosts[index - 1] || null;

const dateStr = formatDate(post.data.date);
---

<BaseLayout title={post.data.title} description={desc} usesKatex={true}>
  <WorkshopNav currentPath={Astro.url.pathname} />

  <article class="post-article">
    <header class="post-masthead">
      <div class="post-meta-row">
        <span class="meta-row">{dateStr}</span>
        <span class="post-read-time">{readTime} min read</span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      {desc ? <p class="post-subtitle">{desc}</p> : null}

      <div class="post-meta-row" style="margin-top: 1.5rem;">
        <time class="meta-row" datetime={post.data.date.toISOString()}>{dateStr}</time>
        {post.data.author ? <span class="meta-row">· {post.data.author}</span> : null}
      </div>

      <div class="ascii-rule" style="margin-top: 2rem;"></div>
    </header>

    {
      tocItems.length > 0 ? (
        <nav class="post-toc" aria-label="Table of contents">
          <p class="post-toc-title">Chart index</p>
          <ul class="post-toc-list">
            {tocItems.map((h) => (
              <li class={`post-toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>
                  <span class="post-toc-text">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : null
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer-nav">
      <div class="ascii-rule" style="margin: 3rem 0 2rem;"></div>
      <div class="post-nav-row">
        {
          prevPost ? (
            <a href={`/blog/${prevPost.slug}/`} class="post-nav-link post-nav-prev">
              <span class="post-nav-label">← Previous entry</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : null
        }
        <a href="/blog/" class="post-nav-back">Back to blog</a>
        {
          nextPost ? (
            <a href={`/blog/${nextPost.slug}/`} class="post-nav-link post-nav-next">
              <span class="post-nav-label">Next entry →</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : null
        }
      </div>
    </footer>
  </article>

  <SiteFooter />
</BaseLayout>

<style>
  .post-article {
    max-width: 65ch;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .post-masthead {
    margin-bottom: 3rem;
  }

  .post-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-read-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-title {
    margin: 1rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
  }

  .post-subtitle {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.333;
    color: var(--ink);
    margin: 0;
    max-width: 55ch;
  }

  .post-toc {
    margin: var(--space-12) 0;
    padding: var(--space-5) var(--space-6);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--r-none);
    box-shadow: none;
  }

  .post-toc-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .post-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.45;
  }

  .post-toc-list li {
    margin: 0 0 var(--space-2);
  }

  .post-toc-list li:last-child {
    margin-bottom: 0;
  }

  .post-toc-list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .post-toc-list a::before {
    content: "·";
    color: var(--ink);
    flex-shrink: 0;
  }

  .post-toc-list a:hover {
    color: var(--ink);
    background: var(--brand-green);
  }

  .post-toc-list a:hover .post-toc-text {
    text-decoration: none;
  }

  .post-toc-depth-3 {
    padding-left: var(--space-5);
  }

  .post-toc-depth-4 {
    padding-left: var(--space-8);
    opacity: 0.75;
  }

  .post-footer-nav {
    margin-top: 2rem;
  }

  .post-nav-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  .post-nav-prev {
    grid-column: 1;
    text-align: left;
  }

  .post-nav-back {
    grid-column: 2;
    justify-self: center;
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--canvas);
    text-decoration: none;
    text-align: center;
    padding: 7px 12px;
    border: 1px solid var(--border-soft);
    border-radius: var(--r-none);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .post-nav-back:hover {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--brand-green);
  }

  .post-nav-next {
    grid-column: 3;
    text-align: right;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.75rem 0;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-nav-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.333;
  }

  .post-nav-link:hover .post-nav-title {
    background: var(--brand-green);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .post-nav-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .post-nav-prev,
    .post-nav-back,
    .post-nav-next {
      grid-column: auto;
    }
    .post-nav-prev,
    .post-nav-next {
      text-align: left;
    }
    .post-nav-back {
      order: -1;
      margin-bottom: 1rem;
    }
    .post-meta-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .post-title {
      font-size: clamp(1.8rem, 8vw, 2.4rem);
    }
  }
</style>
