---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkshopNav from "../../../components/WorkshopNav.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import ScrollProgress from "../../../components/ScrollProgress.astro";
import { getCollection, render } from "astro:content";
import { siteConfig } from "../../../site-config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const published = posts.filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return published.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, index, total: published.length },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  index: number;
  total: number;
}

const { post, index, total } = Astro.props;
const { Content, headings } = await render(post);

const desc = post.data.description?.trim() || siteConfig.description;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

// Calculate read time (rough estimate: 200 words per minute)
const wordCount = post.body?.split(/\s+/).length || 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

// Post number: reverse index (oldest = LAB_001)
const postNumber = String(total - index).padStart(3, "0");

// Adjacent posts
const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const prevPost = allPosts[index + 1] || null;
const nextPost = allPosts[index - 1] || null;

const dateStr = post.data.date.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={desc}>
  <ScrollProgress />
  <WorkshopNav currentPath={Astro.url.pathname} />

  <article class="post-article">
    <header class="post-masthead">
      <div class="post-meta-row">
        <span class="fig-label">LAB_{postNumber} · {dateStr}</span>
        <span class="post-read-time">{readTime} min read</span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      {desc ? <p class="post-subtitle">{desc}</p> : null}

      <div class="post-meta-row" style="margin-top: 1.5rem;">
        <time class="meta-row" datetime={post.data.date.toISOString()}>{dateStr}</time>
        {post.data.author ? <span class="meta-row">· {post.data.author}</span> : null}
        {post.data.tags?.length ? (
          <span class="meta-row">
            ·{" "}
            {post.data.tags.map((t, i) => (
              <>
                {i > 0 ? ", " : ""}<span class="chip">{t}</span>
              </>
            ))}
          </span>
        ) : null}
      </div>

      <div class="ascii-rule" style="margin-top: 2rem;"></div>
    </header>

    {
      tocItems.length > 0 ? (
        <nav class="post-toc-inline" aria-label="Table of contents">
          <p class="fig-label" style="margin-bottom: 0.75rem;">Chart index</p>
          <ul class="post-toc-list">
            {tocItems.map((h) => (
              <li class={`post-toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
          <div class="dotted-rule" style="margin-top: 1.5rem;"></div>
        </nav>
      ) : null
    }

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer-nav">
      <div class="ascii-rule" style="margin: 3rem 0 2rem;"></div>
      <div class="post-nav-row">
        {
          prevPost ? (
            <a href={`/blog/${prevPost.slug}/`} class="post-nav-link post-nav-prev">
              <span class="post-nav-label">← Previous entry</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        <a href="/blog/" class="post-nav-back">Back to notebook</a>
        {
          nextPost ? (
            <a href={`/blog/${nextPost.slug}/`} class="post-nav-link post-nav-next">
              <span class="post-nav-label">Next entry →</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </div>
    </footer>
  </article>

  <SiteFooter />
</BaseLayout>

<style>
  .post-article {
    max-width: 65ch;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .post-masthead {
    margin-bottom: 3rem;
  }

  .post-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-read-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-title {
    margin: 1rem 0 0.75rem;
    line-height: 0.92;
    letter-spacing: 0.02em;
  }

  .post-subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
    max-width: 55ch;
  }

  .post-toc-inline {
    margin: 2rem 0;
  }

  .post-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .post-toc-list li {
    margin: 0;
  }

  .post-toc-list a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .post-toc-list a:hover {
    color: var(--accent);
  }

  .post-toc-depth-3 {
    padding-left: 1rem;
    opacity: 0.7;
  }

  .post-toc-depth-4 {
    padding-left: 2rem;
    opacity: 0.5;
  }

  .post-content {
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .post-content :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-top: 4rem;
    margin-bottom: 1.25rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .post-content :global(h2)::before {
    content: "§";
    position: absolute;
    left: 0;
    top: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.6em;
    color: var(--accent);
    opacity: 0.8;
  }

  .post-content :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .post-content :global(p) {
    margin: 0 0 1.75rem;
    text-align: justify;
    hyphens: auto;
  }

  .post-content :global(p:first-of-type)::first-letter {
    font-family: var(--font-display);
    float: left;
    font-size: 5rem;
    line-height: 0.82;
    padding: 0.05em 0.12em 0 0;
    color: var(--accent);
  }

  .post-content :global(hr) {
    border: 0;
    margin: 3.5rem 0;
    height: 6px;
    background-image:
      repeating-linear-gradient(to right, var(--accent) 0, var(--accent) 4px, transparent 4px, transparent 8px),
      repeating-linear-gradient(to right, transparent 0, transparent 8px, rgba(53,83,255,0.12) 8px, rgba(53,83,255,0.12) 14px);
    background-size: 100% 3px, 100% 3px;
    background-position: 0 0, 0 3px;
    background-repeat: no-repeat;
  }

  html[data-theme="dark"] .post-content :global(hr) {
    background-image:
      repeating-linear-gradient(to right, var(--accent) 0, var(--accent) 4px, transparent 4px, transparent 8px),
      repeating-linear-gradient(to right, transparent 0, transparent 8px, rgba(107,142,255,0.12) 8px, rgba(107,142,255,0.12) 14px);
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.75rem 0 0.75rem 1.5rem;
    border-left: 3px solid var(--accent);
    font-style: italic;
    color: var(--muted);
  }

  .post-content :global(blockquote p) {
    margin: 0 0 1rem;
    text-align: left;
  }

  .post-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(pre) {
    background: var(--pre-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    box-shadow: inset 0 0 0 2px rgba(0,0,0,0.02);
    margin: 2rem 0;
  }

  html[data-theme="dark"] .post-content :global(pre) {
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.02);
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--code-bg);
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .post-content :global(ul, ol) {
    margin: 1.5rem 0;
    padding-left: 1.5em;
  }

  .post-content :global(li) {
    margin-bottom: 0.75rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin: 2rem 0;
  }

  .post-content :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
    margin: 2rem 0;
  }

  .post-content :global(th, td) {
    border: 1px solid var(--line);
    padding: 0.4rem 0.5rem;
  }

  .post-content :global(th) {
    background: var(--table-th-bg);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-footer-nav {
    margin-top: 2rem;
  }

  .post-nav-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.75rem 0;
  }

  .post-nav-prev {
    text-align: left;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .post-nav-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.3;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent);
  }

  .post-nav-back {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    text-align: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .post-nav-back:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .post-nav-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .post-nav-prev,
    .post-nav-next {
      text-align: left;
    }
    .post-nav-back {
      order: -1;
      margin-bottom: 1rem;
    }
    .post-meta-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .post-title {
      font-size: clamp(1.8rem, 8vw, 2.4rem);
    }
  }
</style>
