---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopNav from "../components/WorkshopNav.astro";
import HeroSection from "../components/HeroSection.astro";
import HomeStatusLine from "../components/HomeStatusLine.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../site-config";
import projectsData from "../data/projects.json";

const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    slug: post.slug,
    title: post.data.title,
    date: post.data.date.toISOString().slice(0, 10).replace(/-/g, "."),
    tag: post.data.tags[0],
  }));

const featured = projectsData.projects.slice(0, 3);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <WorkshopNav currentPath={Astro.url.pathname} />

  <HeroSection />
  <HomeStatusLine />

  <section class="index-section" aria-labelledby="sec-experiments">
    <span class="fig-label">SEC_01 · Prototype bay</span>
    <div class="index-section-head">
      <h2 id="sec-experiments">Featured experiments</h2>
      <a class="index-section-link" href="/projects/">All experiments →</a>
    </div>
    <div class="index-projects stagger-in">
      {
        featured.map((proj, i) => (
          <div class="index-project-cell" style={`--index: ${i}`}>
            <ProjectCard
              title={proj.title}
              description={proj.description}
              image={proj.image}
              tags={proj.tags}
              gitHubLink={proj.gitHubLink}
              liveLink={proj.liveLink || undefined}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="index-section" aria-labelledby="sec-notes">
    <span class="fig-label">SEC_02 · Lab notes</span>
    <div class="index-section-head">
      <h2 id="sec-notes">Latest notes</h2>
      <a class="index-section-link" href="/blog/">All notes →</a>
    </div>
    <ul class="index-notes">
      {
        latestPosts.map((post) => (
          <li>
            <a class="index-note-row" href={`/blog/${post.slug}/`}>
              <span class="index-note-date">{post.date}</span>
              <span class="index-note-title">{post.title}</span>
              <span class="dotted-leader" aria-hidden="true" />
              <span class="index-note-tag">{post.tag}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="index-section index-split" aria-label="Dossier and search">
    <a href="/resume/" class="index-tile">
      <span class="fig-label">DOC_001</span>
      <span class="index-tile-title">Technical dossier</span>
      <span class="index-tile-desc">
        Experience, skills, and the path from mathematics to ML engineering.
      </span>
      <span class="index-tile-cta">Open resume →</span>
    </a>
    <a href="/search/" class="index-tile">
      <span class="fig-label">SRC_001</span>
      <span class="index-tile-title">Query the index</span>
      <span class="index-tile-desc">
        Find notes and experiments filed across the lab.
      </span>
      <span class="index-tile-cta">Search →</span>
    </a>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  .index-section {
    margin-top: 1.5rem;
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--line);
  }

  .index-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 1.75rem;
  }

  .index-section-head h2 {
    margin: 0;
  }

  .index-section-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .index-section-link:hover {
    color: var(--accent-hot);
    text-decoration: underline;
  }

  .index-projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  .index-project-cell {
    display: flex;
  }

  .index-project-cell :global(.spotlight-card) {
    width: 100%;
    height: 100%;
  }

  .index-notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-notes li {
    border-bottom: 1px solid var(--line);
  }

  .index-notes li:first-child {
    border-top: 1px solid var(--line);
  }

  .index-note-row {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .index-note-row:hover {
    transform: translateX(4px);
  }

  .index-note-row:hover .index-note-title {
    color: var(--accent);
  }

  .index-note-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .index-note-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .index-note-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    flex-shrink: 0;
  }

  .index-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-bottom: 0;
    border-top: 1px solid var(--line);
  }

  .index-tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    background: var(--canvas-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .index-tile:hover {
    transform: translate(-2px, -2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-hard);
  }

  html[data-theme="dark"] .index-tile:hover {
    box-shadow: var(--shadow-hard), var(--glow);
  }

  .index-tile-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .index-tile-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .index-tile-cta {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .index-projects {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .index-projects,
    .index-split {
      grid-template-columns: 1fr;
    }

    .index-note-tag {
      display: none;
    }
  }
</style>
