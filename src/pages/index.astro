---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopNav from "../components/WorkshopNav.astro";
import HeroSection from "../components/HeroSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../site-config";
import projectsData from "../data/projects.json";

const latestPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    slug: post.slug,
    title: post.data.title,
    date: post.data.date.toISOString().slice(0, 10).replace(/-/g, "."),
  }));

const featured = projectsData.projects.slice(0, 3);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <WorkshopNav currentPath={Astro.url.pathname} />

  <HeroSection />

  <section class="index-section" aria-labelledby="sec-experiments">
    <div class="index-section-head">
      <h2 id="sec-experiments">Featured experiments</h2>
      <a class="index-section-link" href="/projects/">All experiments →</a>
    </div>
    <ul class="index-notes">
      {
        featured.map((proj) => (
          <li>
            <a
              class="index-note-row"
              href={proj.liveLink || proj.gitHubLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="index-note-title">{proj.title}</span>
              <span class="dotted-leader" aria-hidden="true" />
              <span class="index-note-tag">{proj.tags[0]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="index-section" aria-labelledby="sec-notes">
    <div class="index-section-head">
      <h2 id="sec-notes">Latest posts</h2>
      <a class="index-section-link" href="/blog/">All posts →</a>
    </div>
    <ul class="index-notes">
      {
        latestPosts.map((post) => (
          <li>
            <a class="index-note-row" href={`/blog/${post.slug}/`}>
              <span class="index-note-date">{post.date}</span>
              <span class="index-note-title">{post.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="index-section" aria-label="Dossier and search">
    <ul class="index-notes">
      <li>
        <a class="index-note-row" href="/resume/">
          <span class="index-note-title">Technical dossier</span>
          <span class="dotted-leader" aria-hidden="true" />
          <span class="index-note-tag">resume</span>
        </a>
      </li>
      <li>
        <a class="index-note-row" href="/search/">
          <span class="index-note-title">Query the index</span>
          <span class="dotted-leader" aria-hidden="true" />
          <span class="index-note-tag">search</span>
        </a>
      </li>
    </ul>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  .index-section {
    margin-top: 1.5rem;
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--hairline);
  }

  .index-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 1.75rem;
  }

  .index-section-head h2 {
    margin: 0;
    text-transform: none;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .index-section-link {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .index-section-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--brand-green);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .index-notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .index-notes li {
    border-bottom: 1px solid var(--hairline);
  }

  .index-notes li:first-child {
    border-top: 1px solid var(--hairline);
  }

  .index-note-row {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
    color: inherit;
  }

  .index-note-row:hover {
    transform: none;
  }

  .index-note-row:hover .index-note-title {
    text-decoration: underline;
    text-decoration-color: var(--brand-green);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .index-note-date {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    flex-shrink: 0;
  }

  .index-note-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink);
  }

  .index-note-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .index-projects,
    .index-split {
      grid-template-columns: 1fr;
    }

    .index-note-tag {
      display: none;
    }
  }
</style>
