---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkshopNav from "../../components/WorkshopNav.astro";
import KitchenRecipeCard from "../../components/KitchenRecipeCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import recipesData from "../../data/recipes.json";

const recipes = recipesData.recipes;
---

<BaseLayout
  title="The Kitchen"
  description="Data isn't the only thing I alchemize. Here are some recipes I love."
>
  <WorkshopNav currentPath={Astro.url.pathname} />

  <header class="section-hero">
    <span class="fig-label">REC_002 · kitchen</span>
    <h1>The Kitchen</h1>
    <p>Data isn't the only thing I alchemize. Here are some recipes I love.</p>
  </header>

  <div class="recipe-grid">
    {recipes.map((recipe) => <KitchenRecipeCard recipe={recipe} />)}
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .recipe-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    padding-bottom: var(--space-12);
  }

  @media (max-width: 640px) {
    .recipe-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
