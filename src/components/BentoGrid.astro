---
import SpotlightCard from "./SpotlightCard.astro";

interface BlogPost {
  slug: string;
  title: string;
  date: string;
  tag?: string;
}

interface Props {
  posts: BlogPost[];
  postCount: number;
  projectCount: number;
}

const { posts, postCount, projectCount } = Astro.props;
---

<section class="bento-section" aria-label="Dashboard">
  <div class="bento-grid">
    <!-- Projects -->
    <div class="bento-cell bento-cell--projects" style="--index: 0;">
      <SpotlightCard class="bento-card">
        <span slot="title">Projects</span>
        <span slot="description">
          {projectCount} experiments in the workshop — from topological data analysis to game-playing agents.
        </span>
        <a href="/projects/" slot="links" class="bento-link">Browse projects →</a>
      </SpotlightCard>
    </div>

    <!-- Blog -->
    <div class="bento-cell bento-cell--blog" style="--index: 1;">
      <SpotlightCard class="bento-card">
        <span slot="title">Notebook</span>
        <span slot="description">{postCount} notes on machine learning, statistics, and curiosity.</span>
        <ul class="bento-post-list">
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`} class="bento-post-link">
                  <span class="bento-post-date">{post.date.replace(/-/g, ".")}</span>
                  <span class="bento-post-title">{post.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/blog/" slot="links" class="bento-link">View all →</a>
      </SpotlightCard>
    </div>

    <!-- Resume -->
    <div class="bento-cell bento-cell--resume" style="--index: 2;">
      <SpotlightCard class="bento-card">
        <span slot="title">Resume</span>
        <span slot="description">Experience, skills, and the path from mathematics to ML engineering.</span>
        <a href="/resume/" slot="links" class="bento-link">Open resume →</a>
      </SpotlightCard>
    </div>

    <!-- Search -->
    <div class="bento-cell bento-cell--search" style="--index: 3;">
      <SpotlightCard class="bento-card">
        <span slot="title">Search</span>
        <span slot="description">Find notes and experiments across the site.</span>
        <a href="/search/" slot="links" class="bento-link">Search →</a>
      </SpotlightCard>
    </div>
  </div>
</section>

<style>
  .bento-section {
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--line);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(160px, auto);
    gap: 1rem;
    align-items: stretch;
  }

  .bento-cell {
    animation: fade-in-up 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--index, 0) * 100ms);
    min-height: 0;
  }

  .bento-cell--projects {
    grid-column: 1;
    grid-row: 1;
  }

  .bento-cell--resume {
    grid-column: 1;
    grid-row: 2;
  }

  .bento-cell--search {
    grid-column: 1;
    grid-row: 3;
  }

  .bento-cell--blog {
    grid-column: 2;
    grid-row: 1 / 4;
  }

  :global(.spotlight-card.bento-card) {
    height: 100%;
  }

  .bento-post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bento-post-link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: transform 200ms ease;
  }

  .bento-post-link:hover {
    transform: translateX(4px);
  }

  .bento-post-link:hover .bento-post-title {
    color: var(--accent);
  }

  .bento-post-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .bento-post-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    transition: color 200ms ease;
  }

  .bento-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
  }

  .bento-link:hover {
    color: var(--accent-hot);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .bento-cell--projects,
    .bento-cell--blog,
    .bento-cell--resume,
    .bento-cell--search {
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-cell {
      animation: none;
    }
  }
</style>
