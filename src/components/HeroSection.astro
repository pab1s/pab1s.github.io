---
import SocialIconRow from "./SocialIconRow.astro";
import { siteConfig } from "../site-config";
---

<section class="hero-section" aria-labelledby="hero-title">
  <img
    class="hero-avatar"
    src={siteConfig.avatarSrc}
    width="64"
    height="64"
    alt={`${siteConfig.author} portrait`}
    loading="eager"
    decoding="async"
  />

  <h1 id="hero-title" class="hero-title">{siteConfig.author}</h1>
  <p class="hero-subtitle">{siteConfig.tagline}</p>

  <p class="hero-desc">
    I turn raw data into <mark class="highlight-marker">insight</mark>, build things with PyTorch and curiosity,
    and cook up experiments in the lab. {siteConfig.currently}
  </p>

  <SocialIconRow />
</section>

<style>
  .hero-section {
    padding: 1.5rem 0 2rem;
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-none);
    object-fit: cover;
    background: var(--canvas);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 1rem 0 0;
    text-transform: none;
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin: 0.25rem 0 0;
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--ink);
    max-width: 60ch;
    margin: 1rem 0 0;
  }

  .highlight-marker {
    background: var(--brand-green);
    color: var(--near-black);
    padding: 0 4px;
  }

  @media (max-width: 480px) {
    .hero-avatar {
      width: 56px;
      height: 56px;
    }
  }
</style>
