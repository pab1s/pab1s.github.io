---
import SocialIconRow from "./SocialIconRow.astro";
import { siteConfig } from "../site-config";
---

<section class="hero-section" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">{siteConfig.author}</h1>
  <p class="hero-tagline">{siteConfig.tagline}</p>

  <p class="hero-desc">
    I'm Pablo. {siteConfig.currently}
  </p>

  <p class="hero-desc hero-desc-secondary">
    When I'm not at work you'll usually find me out hiking, in the kitchen, planning the next trip, or tinkering on something.
  </p>

  <SocialIconRow />
</section>

<style>
  .hero-section {
    padding: 2rem 0 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin: 0.5rem 0 0;
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--ink);
    max-width: 60ch;
    margin: 1rem 0 1.25rem;
  }

  .highlight-marker {
    background: var(--brand-green);
    color: var(--near-black);
    padding: 0 4px;
  }

  .hero-desc-secondary {
    margin-top: 0.75rem;
    color: var(--ink-muted);
  }
</style>
