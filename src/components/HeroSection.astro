---
import SocialIconRow from "./SocialIconRow.astro";
import { siteConfig } from "../site-config";

const buildDate = new Date().toISOString().slice(0, 10).replace(/-/g, ".");
---

<section class="hero-section" aria-labelledby="hero-title">
  <span class="fig-label">FIG_001 · drawing no. 01 · sheet 1 of 1</span>

  <div class="hero-grid">
    <div class="hero-title-block">
      <div class="hero-avatar-wrap">
        <img
          class="hero-avatar"
          src={siteConfig.avatarSrc}
          width="140"
          height="140"
          alt={`${siteConfig.author} portrait`}
          loading="eager"
          decoding="async"
        />
        <span class="hero-avatar-caption" aria-hidden="true">fig. a</span>
      </div>

      <div class="hero-headline">
        <h1 id="hero-title" class="hero-title">{siteConfig.author}</h1>
        <p class="hero-subtitle">{siteConfig.tagline}</p>
      </div>

      <p class="hero-desc">
        I turn raw data into insight, build things with PyTorch and curiosity,
        and cook up experiments in my digital workshop. {siteConfig.currently}
      </p>

      <div class="hero-callouts">
        <span class="hero-callout">Loc. Granada, ES</span>
        <span class="hero-callout" aria-hidden="true">·</span>
        <span class="hero-callout">Ver. 2.0</span>
        <span class="hero-callout" aria-hidden="true">·</span>
        <span class="hero-callout">Date {buildDate}</span>
        <span class="hero-callout" aria-hidden="true">·</span>
        <span class="hero-callout">Scale 1:1</span>
      </div>

      <SocialIconRow />
    </div>

    <div class="hero-drawing" aria-hidden="true">
      <svg class="blueprint-svg" viewBox="0 0 520 320" preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
            <path d="M 32 0 L 0 0 0 32" fill="none" stroke="var(--accent)" stroke-width="0.5" stroke-opacity="0.12"/>
          </pattern>
        </defs>

        <rect width="520" height="320" fill="url(#grid)" />

        <line x1="40" y1="280" x2="480" y2="280" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="6 4" />
        <line x1="40" y1="280" x2="40" y2="40" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="6 4" />

        <text x="44" y="34" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">Y</text>
        <text x="472" y="296" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">X</text>

        <circle cx="260" cy="160" r="78" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-opacity="0.45" stroke-dasharray="4 4" />
        <circle cx="260" cy="160" r="46" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />
        <circle cx="260" cy="160" r="3" fill="var(--accent)" fill-opacity="0.8" />

        <line x1="120" y1="160" x2="400" y2="160" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.25" stroke-dasharray="3 3" />
        <line x1="260" y1="60" x2="260" y2="260" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.25" stroke-dasharray="3 3" />

        <rect x="360" y="58" width="100" height="54" fill="var(--canvas-elevated)" stroke="var(--line)" stroke-width="1" rx="2" />
        <text x="370" y="78" font-family="var(--font-mono)" font-size="9" font-weight="600" fill="var(--ink-muted)">TITLE</text>
        <text x="370" y="96" font-family="var(--font-mono)" font-size="11" font-weight="600" fill="var(--ink)">PORTFOLIO</text>

        <line x1="40" y1="280" x2="120" y2="220" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="5 3" />
        <line x1="120" y1="220" x2="180" y2="250" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="5 3" />

        <text x="44" y="270" font-family="var(--font-mono)" font-size="8" fill="var(--ink-muted)">0,0</text>
        <text x="188" y="254" font-family="var(--font-mono)" font-size="8" fill="var(--ink-muted)">r = 78</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-title-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-avatar-wrap {
    position: relative;
    align-self: flex-start;
  }

  .hero-avatar {
    width: 140px;
    height: 140px;
    border-radius: 16px;
    border: 2px solid var(--accent);
    object-fit: cover;
    background: var(--canvas-elevated);
  }

  .hero-avatar-caption {
    position: absolute;
    bottom: -0.4rem;
    right: -0.4rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--canvas);
    border: 1px solid var(--line);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
  }

  .hero-headline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    text-transform: none;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--ink-muted);
    max-width: 46ch;
    line-height: 1.65;
    margin: 0.25rem 0 0;
  }

  .hero-callouts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }

  .hero-callout {
    white-space: nowrap;
  }

  .hero-drawing {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    max-width: 540px;
    width: 100%;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--canvas-elevated);
  }

  .blueprint-svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-drawing {
      order: -1;
      margin-left: auto;
      margin-right: auto;
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-avatar {
      width: 120px;
      height: 120px;
      border-radius: 14px;
    }
  }
</style>
