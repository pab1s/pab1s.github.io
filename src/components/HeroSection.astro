---
import NeuralNetViz from "./NeuralNetViz.astro";
import SocialIconRow from "./SocialIconRow.astro";
import { siteConfig } from "../site-config";

interface Props {
  featuredProject: {
    title: string;
    description?: string;
    gitHubLink?: string;
    liveLink?: string;
    image?: string;
    tags?: string[];
  };
}

const { featuredProject } = Astro.props;
---

<section class="hero-section">
  <span class="fig-label">FIG_001 · curiosity workshop v1.0</span>
  <div class="hero-content">
    <img
      class="hero-avatar"
      src={siteConfig.avatarSrc}
      width="80"
      height="80"
      alt={`${siteConfig.author} portrait`}
      loading="eager"
      decoding="async"
    />
    <h1 class="hero-title">Hi, I'm Pablo.</h1>
    <p class="hero-subtitle">ML engineer · data alchemist · tinkerer</p>
    <p class="hero-desc">
      I turn raw data into insight, build things with PyTorch and curiosity,
      and cook up experiments in my digital workshop. Currently engineering ML
      at Santander.
    </p>
    <SocialIconRow />
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 55ch;
    margin: 0 auto;
  }

  .hero-avatar {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    border: 2px solid var(--accent);
    object-fit: cover;
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    text-transform: none;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 45ch;
    line-height: 1.65;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2rem 0 1.5rem;
    }
    .hero-title {
      font-size: clamp(2.2rem, 9vw, 2.8rem);
    }
  }
</style>
