---
import { siteConfig } from "../site-config";
---

<ul class="orbit-social-row">
  {
    siteConfig.social.map((s) => (
      <li>
        <a
          class="orbit-social-icon-link"
          href={s.href}
          aria-label={s.name}
          rel={s.href.startsWith("mailto:") ? undefined : "me noopener noreferrer"}
          target={s.href.startsWith("mailto:") ? undefined : "_blank"}
        >
          {s.icon === "github" ? (
            <svg class="orbit-social-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .5C5.73.5.5 5.73.5 12.02c0 5.09 3.29 9.43 7.87 10.96.58.11.79-.24.79-.53 0-.26-.02-1.13-.03-2.06-3.19.58-3.87-1.37-3.87-1.37-.53-1.28-1.28-1.62-1.28-1.62-1.04-.69.08-.67.08-.67 1.15.07 1.76 1.18 1.76 1.18 1.02 1.77 2.68 1.26 3.34.96.09-.73.41-1.26.71-1.55-2.55-.29-5.23-1.29-5.23-5.71 0-1.26.44-2.31 1.18-3.13-.13-.29-.53-1.47.09-3.06 0 0 .97-.31 3.17 1.17.93-.26 1.92-.39 2.92-.39.99 0 1.99.13 2.92.39 2.21-1.49 3.17-1.17 3.17-1.17.62 1.59.22 2.76.09 3.06.73.82 1.18 1.86 1.18 3.13 0 4.45-2.69 5.43-5.25 5.71.42.37.79 1.08.79 2.21 0 1.61-.03 2.88-.03 3.29 0 .29.21.63.81.53A10.53 10.53 0 0023.5 12C23.5 5.73 18.27.5 12 .5z"
              />
            </svg>
          ) : s.icon === "linkedin" ? (
            <svg class="orbit-social-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.068 2.068 0 01-2.064-2.065c0-1.138.921-2.063 2.064-2.063a2.064 2.064 0 012.064 2.063c0 1.139-.924 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
          ) : (
            <svg class="orbit-social-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z"
              />
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M2 10l10 7 10-7"></path>
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
