---
import { siteConfig, telemetryLines } from "../site-config";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-row">
      <span class="site-footer-status" data-footer-status data-lines={JSON.stringify(telemetryLines)}>
        {telemetryLines[0]}
      </span>
      <div class="site-footer-socials">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} rel="me noopener noreferrer" target={s.href.startsWith("mailto:") ? undefined : "_blank"}>
              {s.name}
            </a>
          ))
        }
      </div>
    </div>
    <p class="site-footer-copy">
      Built with <a href="https://astro.build">Astro</a> · Blueprints strictly aspirational · The Curiosity Workshop
    </p>
  </div>
</footer>

<script>
  const el = document.querySelector<HTMLElement>("[data-footer-status]");
  if (el?.dataset.lines) {
    const lines = JSON.parse(el.dataset.lines) as string[];
    let i = 0;
    setInterval(() => {
      i = (i + 1) % lines.length;
      el.textContent = lines[i];
    }, 5200);
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: transparent;
    margin-top: 3rem;
    padding: 2rem 0;
  }
</style>
