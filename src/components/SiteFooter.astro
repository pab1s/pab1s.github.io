---
import { siteConfig, telemetryLines } from "../site-config";
import SocialIconRow from "./SocialIconRow.astro";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <span class="site-footer-name">
        <span class="site-footer-mark" aria-hidden="true"></span>{siteConfig.labName}
      </span>
      <span class="site-footer-tagline">{siteConfig.tagline}</span>
    </div>

    <div class="site-footer-aside">
      <SocialIconRow />
      <span
        class="site-footer-status"
        data-footer-status
        tabindex="0"
        data-lines={JSON.stringify(telemetryLines)}
        data-initial-index={siteConfig.homeFeed.telemetryLineIndex}
      >
        {telemetryLines[siteConfig.homeFeed.telemetryLineIndex]}
      </span>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector<HTMLElement>("[data-footer-status]");
  if (el?.dataset.lines) {
    const lines = JSON.parse(el.dataset.lines) as string[];
    let i = parseInt(el.dataset.initialIndex || "0", 10) || 0;
    let timer: number | null = null;

    function prefersReducedMotion() {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    function tick() {
      i = (i + 1) % lines.length;
      el.textContent = lines[i];
    }

    function start() {
      if (prefersReducedMotion()) return;
      if (timer !== null) clearInterval(timer);
      timer = window.setInterval(tick, 5200);
    }

    function stop() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    el.textContent = lines[i];
    start();

    el.addEventListener("mouseenter", stop);
    el.addEventListener("mouseleave", start);
    el.addEventListener("focusin", stop);
    el.addEventListener("focusout", start);
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    background: transparent;
    margin-top: 3rem;
    padding: 1.5rem 0;
  }

  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .site-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-footer-name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink);
  }

  .site-footer-mark {
    width: 9px;
    height: 9px;
    background: var(--brand-green);
    box-shadow: none;
    flex-shrink: 0;
  }

  .site-footer-tagline {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  .site-footer-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
  }

  .site-footer-aside :global(.social-icon-row) {
    gap: 0.25rem;
  }

  .site-footer-aside :global(.social-icon-link) {
    width: 1.75rem;
    height: 1.75rem;
    border-color: transparent;
    background: transparent;
    color: var(--ink-muted);
  }

  .site-footer-aside :global(.social-icon-link:hover) {
    color: var(--ink);
    border-color: transparent;
    background: var(--brand-green);
  }

  .site-footer-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    cursor: default;
    display: inline-flex;
    align-items: center;
  }

  .site-footer-status::before {
    content: "";
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--brand-green);
    margin-right: 0.5rem;
    animation: footer-pulse 5.2s ease-in-out infinite;
  }

  @keyframes footer-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer-status::before {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .site-footer-aside {
      align-items: flex-start;
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
