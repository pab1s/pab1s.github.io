---
import cv from "../data/cv.json";
---

<section class="resume-content prose">
  <header>
    <h1>{cv.basics.name}</h1>
    <p class="meta-row">{cv.basics.label}</p>
    <p>
      <a href={`mailto:${cv.basics.email}`}>{cv.basics.email}</a>
    </p>
    <p class="meta-row">
      {cv.basics.location.city}, {cv.basics.location.countryCode}
    </p>
  </header>

  <section>
    <h2>Summary</h2>
    <p>{cv.basics.summary}</p>
  </section>

  <section>
    <h2>Work experience</h2>
    {
      cv.work.map((job) => (
        <article>
          <h3>
            {job.position}{" "}
            <span class="at-separator">@</span>{" "}
            <a href={job.url} target="_blank" rel="noopener noreferrer">
              {job.name}
            </a>
          </h3>
          <p class="meta-row">
            {job.startDate} — {(job as { endDate?: string }).endDate ?? "Present"}
          </p>
          <p class="meta-row">{job.location}</p>
          {"summary" in job && (job as { summary?: string }).summary ? (
            <p>{(job as { summary: string }).summary}</p>
          ) : null}
          <ul>
            {job.highlights.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Education</h2>
    {
      cv.education.map((edu) => (
        <article>
          <h3>
            {edu.studyType} in {edu.area} at {edu.institution}
          </h3>
          <p class="meta-row">
            {edu.startDate} — {edu.endDate}
          </p>
          <ul>
            {(edu.courses ?? []).map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Highlighted projects</h2>
    {
      cv.projects.map((proj) => (
        <article>
          <h3>
            <a href={proj.url} target="_blank" rel="noopener noreferrer">
              {proj.name}
            </a>
          </h3>
          <p class="meta-row">
            {proj.startDate} — {proj.endDate}
          </p>
          <p>{proj.description}</p>
          <ul>
            {proj.highlights.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>Skills</h2>
    {
      cv.skills.map((category) => (
        <div class="skill-category">
          <h3>{category.name}</h3>
          <div class="skill-grid">
            {category.keywords.map((skill) => (
              <div class="skill-item">
                <span class="skill-name">{skill}</span>
                <div class="skill-bar-outer">
                  <div class="skill-bar-inner" />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section>
    <h2>Languages</h2>
    <ul class="language-list">
      {
        cv.languages.map((l) => (
          <li>
            {l.language} — {l.fluency}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Volunteering</h2>
    {
      cv.volunteer.map((v) => (
        <article>
          <h3>
            {v.position} @{" "}
            <a href={v.url} target="_blank" rel="noopener noreferrer">
              {v.organization}
            </a>
          </h3>
          <p class="meta-row">
            {v.startDate} — {v.endDate ?? "Present"}
          </p>
          <p>{v.summary}</p>
        </article>
      ))
    }
  </section>
</section>

<style>
  .resume-content header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .resume-content header h1 {
    margin: 0.35rem 0 0;
    border: none;
    padding: 0;
  }
  .resume-content header .meta-row {
    margin: 0.35rem 0;
  }
  .resume-content header p:last-of-type.meta-row {
    margin: 0.22rem 0;
  }

  .at-separator {
    color: var(--muted);
    font-weight: 400;
  }

  .skill-category {
    margin-bottom: 1.5rem;
  }

  .skill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }

  .skill-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 140px;
  }

  .skill-name {
    font-size: 0.85rem;
    color: var(--ink);
  }

  .language-list {
    padding-left: 1.05rem;
    margin-top: 0.25rem;
  }

  @media print {
    .resume-content { max-width: 100%; }
    .workshop-nav, .noise-overlay, .stars, .theme-cycle-btn { display: none !important; }
  }
</style>
