---

<div class="nn-viz-mount">
  <div class="nn-viz-legend">
    <span class="stamp">MANIFOLD UNFOLDING</span>
    <p class="nn-viz-caption">Feedforward network learning topology · 2 → 4 → 1</p>
  </div>
  <canvas id="nn-viz-canvas" class="nn-viz-canvas" width="720" height="720" aria-hidden="true"
  ></canvas>
  <div class="nn-viz-coords" data-nn-coords aria-hidden="true">
    <span class="nn-viz-coords-label">Training in progress...</span>
  </div>
</div>

<script>
  import { attachNeuralNetViz } from "../lib/neural-net-viz";

  function boot() {
    const canvas = document.getElementById("nn-viz-canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    attachNeuralNetViz(canvas);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
</script>

<style>
  .nn-viz-mount {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    background: var(--panel);
    overflow: hidden;
  }

  .nn-viz-legend {
    position: absolute;
    top: 8px;
    left: 10px;
    right: 10px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    z-index: 2;
    pointer-events: none;
  }

  .nn-viz-caption {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
    text-align: right;
  }

  .nn-viz-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .nn-viz-coords {
    position: absolute;
    bottom: 8px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--muted);
    pointer-events: none;
    z-index: 2;
  }

  .nn-viz-coords-label {
    opacity: 0.7;
  }
</style>
