---
import { formatDate } from "../lib/date";

interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags: string[];
  readTime?: number;
}

const { slug, title, date, description, tags, readTime } = Astro.props;

const dateStr = formatDate(date);
---

<div class="blog-post-row">
  <div class="blog-post-meta">
    <time class="blog-post-date" datetime={date.toISOString()}>
      {dateStr}
    </time>
    {readTime ? (
      <span class="blog-post-read-time" aria-label={`${readTime} minute read`}>
        {readTime} min
      </span>
    ) : null}
  </div>
  <div class="blog-post-main">
    <h2 class="blog-post-title">
      <a href={`/blog/${slug}/`}>{title}</a>
    </h2>
    {description?.trim() ? (
      <p class="blog-post-description">{description}</p>
    ) : null}
    {tags.length ? (
      <div class="blog-post-tags">
        {tags.map((t) => (
          <span class="blog-post-tag">{t}</span>
        ))}
      </div>
    ) : null}
  </div>
</div>

<style>
  .blog-post-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-6) 0;
    border-bottom: 1px dotted var(--line);
    transition: border-color var(--duration-fast) ease;
  }

  .blog-post-row:first-child {
    padding-top: 0;
  }

  .blog-post-row:hover {
    border-bottom-color: var(--line-strong);
  }

  .blog-post-row:hover .blog-post-title a {
    color: var(--accent);
  }

  .blog-post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .blog-post-date {
    color: var(--ink);
  }

  .blog-post-read-time {
    color: var(--ink-muted);
  }

  .blog-post-main {
    min-width: 0;
  }

  .blog-post-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }

  .blog-post-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .blog-post-description {
    font-size: 0.94rem;
    color: var(--ink-muted);
    max-width: 55ch;
    line-height: 1.55;
    margin: var(--space-2) 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .blog-post-tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    padding: 0.12rem 0.38rem;
    border-radius: 1px;
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .blog-post-row:hover .blog-post-tag {
    border-color: var(--line-strong);
  }

  @media (max-width: 640px) {
    .blog-post-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }

    .blog-post-meta {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }
  }
</style>
