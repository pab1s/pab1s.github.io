---
import { formatDate } from "../lib/date";

interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags: string[];
  readTime?: number;
}

const { slug, title, date, description, tags, readTime } = Astro.props;

const dateStr = formatDate(date);
---

<div class="blog-post-row">
  <div class="blog-post-meta">
    <time class="blog-post-date" datetime={date.toISOString()}>
      {dateStr}
    </time>
    {readTime ? (
      <span class="blog-post-read-time" aria-label={`${readTime} minute read`}>
        {readTime} min
      </span>
    ) : null}
  </div>
  <div class="blog-post-main">
    <h2 class="blog-post-title">
      <a href={`/blog/${slug}/`}>{title}</a>
    </h2>
    {description?.trim() ? (
      <p class="blog-post-description">{description}</p>
    ) : null}
  </div>
</div>

<style>
  .blog-post-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-6) 0;
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
    border-radius: var(--r-none);
    box-shadow: none;
  }

  .blog-post-row:first-child {
    padding-top: 0;
  }

  .blog-post-row:hover {
    border-bottom-color: var(--ink);
  }

  .blog-post-row:hover .blog-post-title a {
    background: var(--brand-green);
    color: var(--ink);
  }

  .blog-post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    letter-spacing: normal;
    flex-shrink: 0;
  }

  .blog-post-date {
    color: var(--ink);
  }

  .blog-post-read-time {
    color: var(--ink);
  }

  .blog-post-main {
    min-width: 0;
  }

  .blog-post-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    line-height: 1.333;
    letter-spacing: -0.48px;
  }

  .blog-post-title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-post-description {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    max-width: 55ch;
    line-height: 1.5;
    margin: var(--space-2) 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .blog-post-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }

    .blog-post-meta {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }
  }
</style>
