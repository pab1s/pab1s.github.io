---
import SpotlightCard from "./SpotlightCard.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  gitHubLink: string;
  liveLink?: string;
  featured?: boolean;
}

const { title, description, image, tags, gitHubLink, liveLink, featured = false } = Astro.props;
---

<SpotlightCard class="project-card">
  {
    image ? (
      <div class={`project-image-container ${featured ? "project-image-container--featured" : ""}`}>
        <img src={image} alt={title} loading="lazy" />
      </div>
    ) : null
  }
  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>
    {
      tags?.length ? (
        <div class="project-tags">
          {tags.map((tag) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      ) : null
    }
    <div class="project-links">
      <a href={gitHubLink} target="_blank" rel="noopener noreferrer">View recipe →</a>
      {liveLink ? (
        <a href={liveLink} target="_blank" rel="noopener noreferrer">Live demo →</a>
      ) : null}
    </div>
  </div>
</SpotlightCard>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border-radius: var(--radius);
  }

  .project-image-container {
    height: 140px;
    width: 100%;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
  }

  .project-image-container--featured {
    height: 200px;
  }

  .project-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .project-card:hover .project-image-container img {
    transform: scale(1.05);
  }

  .project-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-content h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .project-content p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid rgba(91, 141, 184, 0.2);
    border-radius: 999px;
    color: var(--accent);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
  }

  .project-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--link-underline);
    font-size: 0.9rem;
  }

  .project-links a:hover {
    color: var(--link-hover);
  }
</style>
