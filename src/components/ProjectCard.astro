---
import SpotlightCard from "./SpotlightCard.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  gitHubLink: string;
  liveLink?: string;
  featured?: boolean;
}

const { title, description, image, tags, gitHubLink, liveLink, featured = false } = Astro.props;
---

<SpotlightCard class={`project-card ${featured ? "project-card--featured" : ""}`}>
  {
    image ? (
      <div slot="image" class="project-image-wrap">
        <img src={image} alt={title} loading="lazy" />
      </div>
    ) : null
  }
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{description}</Fragment>
  {
    tags?.length ? (
      <div slot="tags" class="project-tags">
        {tags.map((tag) => (
          <span class="project-tag">{tag}</span>
        ))}
      </div>
    ) : null
  }
  <div slot="links" class="project-links">
    <a href={gitHubLink} target="_blank" rel="noopener noreferrer">View code<span class="sr-only"> (opens in new tab)</span> →</a>
    {liveLink ? (
      <a href={liveLink} target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> (opens in new tab)</span> →</a>
    ) : null}
  </div>
</SpotlightCard>

<style>
  .project-image-wrap {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
  }

  .project-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }

  .project-card:hover .project-image-wrap img {
    transform: scale(1.05);
  }

  .project-tags {
    display: contents;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent);
    transition: border-color var(--duration-fast) var(--ease-out-expo);
  }

  .project-card:hover .project-tag {
    border-color: var(--accent-soft);
  }

  .project-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-soft);
    font-size: 0.9rem;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .project-links a:hover {
    color: var(--accent-hot);
  }
</style>
