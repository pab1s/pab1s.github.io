---
import SpotlightCard from "./SpotlightCard.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  gitHubLink: string;
  liveLink?: string;
}

const { title, description, image, tags, gitHubLink, liveLink } = Astro.props;
---

<SpotlightCard class="project-card">
  {
    image ? (
      <div slot="image" class="project-image-wrap">
        <img src={image} alt={title} loading="lazy" />
      </div>
    ) : null
  }
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{description}</Fragment>
  {
    tags?.length ? (
      <div slot="tags" class="project-tags">
        {tags.map((tag) => (
          <span class="project-tag">{tag}</span>
        ))}
      </div>
    ) : null
  }
  <div slot="links" class="project-links">
    <a href={gitHubLink} target="_blank" rel="noopener noreferrer">View code<span class="sr-only"> (opens in new tab)</span> →</a>
    {liveLink ? (
      <a href={liveLink} target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> (opens in new tab)</span> →</a>
    ) : null}
  </div>
</SpotlightCard>

<style>
  .project-image-wrap {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }

  .project-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card:hover .project-image-wrap img {
    transform: none;
  }

  .project-tags {
    display: contents;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 16px;
    padding: 7px 12px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--surface-soft);
    color: var(--ink);
  }

  .project-card:hover .project-tag {
    border-color: transparent;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .project-links a {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }

  .project-links a:hover {
    background: var(--brand-green);
    color: var(--ink);
  }
</style>
