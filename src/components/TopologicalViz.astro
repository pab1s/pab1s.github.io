---
// Persistent homology of a torus — Vietoris–Rips complex (build-time generator).
// Pure SVG + CSS animation, no client JS. Theme-reactive via CSS custom properties.

function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const R = 1.6;
const r = 0.6;
const nu = 18;
const nv = 6;
const N = nu * nv;
const eps = 0.7;
const jitter = 0.15;

interface P3 { x: number; y: number; z: number; }
const pts: P3[] = [];
const rng = mulberry32(7);
for (let i = 0; i < nu; i++) {
  for (let j = 0; j < nv; j++) {
    const u = (i / nu) * Math.PI * 2 + (rng() - 0.5) * jitter;
    const v = (j / nv) * Math.PI * 2 + (rng() - 0.5) * jitter;
    pts.push({
      x: (R + r * Math.cos(v)) * Math.cos(u),
      y: (R + r * Math.cos(v)) * Math.sin(u),
      z: r * Math.sin(v),
    });
  }
}

const rotY = 0.5;
const rotX = 0.3;
const fov = 400;
const camDist = 4.2;

function proj(p: P3): { x: number; y: number } {
  const x1 = p.x * Math.cos(rotY) + p.z * Math.sin(rotY);
  const z1 = -p.x * Math.sin(rotY) + p.z * Math.cos(rotY);
  const y2 = p.y * Math.cos(rotX) - z1 * Math.sin(rotX);
  const z2 = p.y * Math.sin(rotX) + z1 * Math.cos(rotX);
  const s = fov / (camDist - z2);
  return { x: 360 + x1 * s, y: 225 + y2 * s };
}

const pts2 = pts.map(proj);

function dist3(a: P3, b: P3): number {
  return Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);
}

interface Edge { a: number; b: number; len3: number; len2: number; }
const edges: Edge[] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    const d = dist3(pts[i], pts[j]);
    if (d < eps) {
      const a = pts2[i], b = pts2[j];
      edges.push({ a: i, b: j, len3: d, len2: Math.hypot(a.x - b.x, a.y - b.y) });
    }
  }
}
edges.sort((a, b) => a.len3 - b.len3);

const adj: boolean[][] = Array.from({ length: N }, () => new Array(N).fill(false));
for (const e of edges) {
  adj[e.a][e.b] = true;
  adj[e.b][e.a] = true;
}

interface Tri { a: number; b: number; c: number; maxEdge: number; }
const tris: Tri[] = [];
for (let i = 0; i < N; i++) {
  for (let j = i + 1; j < N; j++) {
    if (!adj[i][j]) continue;
    for (let k = j + 1; k < N; k++) {
      if (adj[i][k] && adj[j][k]) {
        tris.push({
          a: i, b: j, c: k,
          maxEdge: Math.max(dist3(pts[i], pts[j]), dist3(pts[i], pts[k]), dist3(pts[j], pts[k])),
        });
      }
    }
  }
}
tris.sort((a, b) => a.maxEdge - b.maxEdge);

const holePts: string[] = [];
for (let i = 0; i <= 64; i++) {
  const u = (i / 64) * Math.PI * 2;
  const s = proj({ x: (R - r) * Math.cos(u), y: (R - r) * Math.sin(u), z: 0 });
  holePts.push(`${s.x.toFixed(1)},${s.y.toFixed(1)}`);
}
const holePath = holePts.join(" ");

const allX = [...pts2, ...holePts.map((p) => { const [x] = p.split(",").map(Number); return { x, y: 0 }; })];
const xMin = Math.min(...allX.map((p) => p.x));
const xMax = Math.max(...allX.map((p) => p.x));
const yMin = Math.min(...pts2.map((p) => p.y));
const yMax = Math.max(...pts2.map((p) => p.y));
const pad = 36;
const vbX = xMin - pad;
const vbY = yMin - pad;
const vbW = (xMax - xMin) + pad * 2;
const vbH = (yMax - yMin) + pad * 2 + 60;
const bettiX = vbX + vbW / 2;
const bettiY = yMax + 50;

const f1 = (n: number) => n.toFixed(1);
const cx = (xMin + xMax) / 2;
const cy = (yMin + yMax) / 2;
---

<div class="tda-viz-mount">
  <svg
    class="tda-viz"
    viewBox={`${f1(vbX)} ${f1(vbY)} ${f1(vbW)} ${f1(vbH)}`}
    style={`--cx:${f1(cx)}px;--cy:${f1(cy)}px`}
    role="img"
    aria-label="Vietoris–Rips complex grown on a torus point cloud, revealing persistent homology: Betti numbers beta-zero equals one, beta-one equals two, beta-two equals one."
  >
    <g class="tda-torus">
      <g class="tda-tris">
        {tris.map((t, i) => (
          <polygon
            class="tda-tri"
            points={`${f1(pts2[t.a].x)},${f1(pts2[t.a].y)} ${f1(pts2[t.b].x)},${f1(pts2[t.b].y)} ${f1(pts2[t.c].x)},${f1(pts2[t.c].y)}`}
            style={`--i:${i}`}
          />
        ))}
      </g>

      <g class="tda-edges">
        {edges.map((e, i) => (
          <line
            class="tda-edge"
            x1={f1(pts2[e.a].x)}
            y1={f1(pts2[e.a].y)}
            x2={f1(pts2[e.b].x)}
            y2={f1(pts2[e.b].y)}
            style={`--i:${i};--len:${e.len2.toFixed(1)}`}
          />
        ))}
      </g>

      <g class="tda-pts">
        {pts2.map((p, i) => (
          <circle class="tda-pt" cx={f1(p.x)} cy={f1(p.y)} r="2.4" style={`--i:${i}`} />
        ))}
      </g>

      <polygon class="tda-loop" points={holePath} />
    </g>

    <text class="tda-betti" x={f1(bettiX)} y={f1(bettiY)} text-anchor="middle">
      β₀=1  ·  β₁=2  ·  β₂=1
    </text>
  </svg>
</div>

<style>
  .tda-viz-mount {
    position: relative;
    width: 100%;
  }

  .tda-viz {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tda-torus {
    transform-origin: var(--cx, 360px) var(--cy, 225px);
    transform-box: view-box;
    animation: tda-spin 60s linear infinite;
  }

  .tda-pt {
    fill: var(--accent);
    animation: tda-twinkle 3s ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.04s);
  }

  .tda-edge {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    fill: none;
    opacity: 0;
    animation: tda-edge-life 8s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.06s);
  }

  .tda-tri {
    fill: var(--accent);
    stroke: none;
    opacity: 0;
    animation: tda-tri-life 10s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.12s);
  }

  .tda-loop {
    fill: none;
    stroke: var(--accent-hot);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0;
    animation: tda-loop-pulse 4.5s ease-in-out 1.5s infinite;
  }

  .tda-betti {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    fill: var(--accent-hot);
    letter-spacing: 0.12em;
    opacity: 0;
    animation: tda-betti-in 1.4s ease-out 1s forwards;
  }

  @keyframes tda-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes tda-twinkle {
    from { opacity: 0.5; }
    to   { opacity: 1; }
  }

  @keyframes tda-edge-life {
    0%   { stroke-dashoffset: var(--len); opacity: 0; }
    6%   { opacity: 0.55; }
    35%  { stroke-dashoffset: 0; opacity: 0.55; }
    70%  { stroke-dashoffset: 0; opacity: 0.4; }
    88%  { opacity: 0; }
    100% { stroke-dashoffset: var(--len); opacity: 0; }
  }

  @keyframes tda-tri-life {
    0%, 100% { opacity: 0; }
    20%      { opacity: 0.07; }
    55%      { opacity: 0.13; }
    80%      { opacity: 0.04; }
  }

  @keyframes tda-loop-pulse {
    0%, 100% { opacity: 0.25; stroke-width: 1.5; }
    50%      { opacity: 0.85; stroke-width: 3; }
  }

  @keyframes tda-betti-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tda-torus,
    .tda-pt,
    .tda-edge,
    .tda-tri,
    .tda-loop,
    .tda-betti {
      animation: none !important;
    }
    .tda-pt { opacity: 0.9; }
    .tda-edge { stroke-dashoffset: 0; opacity: 0.5; }
    .tda-tri { opacity: 0.1; }
    .tda-loop { opacity: 0.7; stroke-width: 2; }
    .tda-betti { opacity: 1; }
  }
</style>
