---
import { telemetryLines, siteConfig } from "../site-config";

const status = telemetryLines[siteConfig.homeFeed.telemetryLineIndex] ?? telemetryLines[0];
---

<div class="home-status-line">
  <span class="status-pulse" aria-hidden="true"></span>
  <span class="status-label">System status</span>
  <span class="status-value">{status}</span>
</div>

<style>
  .home-status-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink);
    padding: 0.75rem 0;
    border-bottom: 1px solid transparent;
    background-image: repeating-linear-gradient(to right, var(--hairline) 0 var(--dash-len), transparent var(--dash-len) calc(var(--dash-len) + var(--dash-gap)));
    background-size: 100% 1px;
    background-position: bottom;
    background-repeat: no-repeat;
}

  .status-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: none;
    animation: none;
  }

  .status-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .status-value {
    margin-left: auto;
    text-align: right;
  }
</style>
