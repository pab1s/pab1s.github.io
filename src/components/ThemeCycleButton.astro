---
interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Cambiar tema claro / oscuro" } = Astro.props;
---

<button type="button" class="theme-cycle-btn" data-theme-cycle aria-label={ariaLabel}>
  <svg
    class="theme-cycle-svg theme-cycle-svg--sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="theme-cycle-svg theme-cycle-svg--moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 14.75A8.002 8.002 0 0110.75 4 7 7 0 0012 21a8 8 0 009-6.25z"
    ></path>
  </svg>
</button>

<style>
  .theme-cycle-btn:hover {
    box-shadow: 0 0 12px rgba(212, 165, 116, 0.3);
  }
</style>
