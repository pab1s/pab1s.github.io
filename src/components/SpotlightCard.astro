---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const hasImage = Astro.slots.has("image");
const hasTitle = Astro.slots.has("title");
const hasDescription = Astro.slots.has("description");
const hasDefault = Astro.slots.has("default");
const hasTags = Astro.slots.has("tags");
const hasLinks = Astro.slots.has("links");

const structured =
  hasImage ||
  hasTitle ||
  hasDescription ||
  hasDefault ||
  hasTags ||
  hasLinks;
---

<article class={`spotlight-card ${className}`}>
  {
    structured ? (
      <>
        {hasImage ? (
          <figure class="card-image">
            <slot name="image" />
          </figure>
        ) : null}
        {hasTitle || hasDescription || hasDefault ? (
          <div class="card-body">
            {hasTitle ? (
              <h2 class="card-title"><slot name="title" /></h2>
            ) : null}
            {hasDescription ? (
              <p class="card-description"><slot name="description" /></p>
            ) : null}
            {hasDefault ? (
              <div class="card-extra"><slot /></div>
            ) : null}
          </div>
        ) : null}
        {hasTags || hasLinks ? (
          <footer class="card-footer">
            {hasTags ? (
              <div class="card-tags"><slot name="tags" /></div>
            ) : null}
            {hasLinks ? (
              <div class="card-links"><slot name="links" /></div>
            ) : null}
          </footer>
        ) : null}
      </>
    ) : (
      <slot />
    )
  }
</article>

<style>
  .spotlight-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--canvas);
    border-radius: var(--r-none);
    border: 1px solid var(--hairline);
    overflow: hidden;
    box-shadow: none;
    transition: border-color var(--duration-base) var(--ease-out-expo);
  }

  .spotlight-card:hover {
    border-color: var(--ink);
    box-shadow: none;
    transform: none;
  }

  .card-image {
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.333;
    letter-spacing: -0.48px;
    color: var(--ink);
    margin: 0;
  }

  .card-description {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.333;
    letter-spacing: -0.48px;
    color: var(--ink);
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .card-extra {
    display: flex;
    flex-direction: column;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 24px 24px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-links a:hover {
    background: var(--brand-green);
    color: var(--ink);
  }
</style>
