---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const structured =
  Astro.slots.has("image") ||
  Astro.slots.has("title") ||
  Astro.slots.has("description") ||
  Astro.slots.has("tags") ||
  Astro.slots.has("links");
---

<article class={`spotlight-card ${className}`} data-spotlight>
  {
    structured ? (
      <>
        <figure class="card-image">
          <slot name="image" />
        </figure>
        <div class="card-body">
          <h3 class="card-title"><slot name="title" /></h3>
          <p class="card-description"><slot name="description" /></p>
          <div class="card-extra"><slot /></div>
        </div>
        <footer class="card-footer">
          <div class="card-tags"><slot name="tags" /></div>
          <div class="card-links"><slot name="links" /></div>
        </footer>
      </>
    ) : (
      <slot />
    )
  }
</article>

<script>
  (function () {
    const cards = document.querySelectorAll("[data-spotlight]");
    cards.forEach((card) => {
      const el = card as HTMLElement;
      el.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        el.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        el.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });
  })();
</script>

<style>
  .spotlight-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--canvas-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo);
    isolation: isolate;
  }

  .spotlight-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    background: radial-gradient(
      500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(18, 18, 20, 0.05),
      transparent 50%
    );
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-expo);
    pointer-events: none;
    z-index: 0;
  }

  html[data-theme="dark"] .spotlight-card::before {
    background: radial-gradient(
      500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(232, 232, 234, 0.05),
      transparent 50%
    );
  }

  .spotlight-card:hover::before {
    opacity: 1;
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-soft);
  }

  .spotlight-card > * {
    position: relative;
    z-index: 1;
  }

  .card-image {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .card-image:empty {
    display: none;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }

  .card-title:empty {
    display: none;
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0;
  }

  .card-description:empty {
    display: none;
  }

  .card-extra {
    display: flex;
    flex-direction: column;
  }

  .card-extra:empty {
    display: none;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 1.25rem 1.25rem;
  }

  .card-footer:empty {
    display: none;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card-tags:empty {
    display: none;
  }

  .card-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-links:empty {
    display: none;
  }
</style>
