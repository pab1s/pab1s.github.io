---
import SpotlightCard from "./SpotlightCard.astro";

interface Props {
  recipe: {
    title: string;
    cuisine: string;
    difficulty: string;
    prepTime: string;
    ingredients: string[];
    method: string[];
    photo: string;
    personalNote: string;
    alchemyPrinciple: string;
  };
}

const { recipe } = Astro.props;
---

<SpotlightCard class="kitchen-recipe-card">
  <img slot="image" src={recipe.photo} alt={recipe.title} class="recipe-image" loading="lazy" />
  <Fragment slot="title">{recipe.title}</Fragment>
  <div slot="tags" class="recipe-meta">
    <span class="cuisine-tag">{recipe.cuisine}</span>
    <span class="difficulty-badge">{recipe.difficulty}</span>
    <span class="prep-time">{recipe.prepTime}</span>
  </div>

  <div class="recipe-body">
    <div class="recipe-section">
      <h4>Ingredients</h4>
      <ul class="recipe-list">
        {recipe.ingredients.map((ing) => <li>{ing}</li>)}
      </ul>
    </div>

    <div class="recipe-section">
      <h4>Method</h4>
      <ol class="recipe-list recipe-list--numbered">
        {recipe.method.map((step) => <li>{step}</li>)}
      </ol>
    </div>

    <blockquote class="recipe-note">
      {recipe.personalNote}
    </blockquote>

    <div class="recipe-alchemy">
      {recipe.alchemyPrinciple}
    </div>
  </div>
</SpotlightCard>

<style>
  .kitchen-recipe-card {
    /* SpotlightCard provides surface, border, and hover lift */
  }

  .recipe-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .recipe-meta {
    display: contents;
  }

  .cuisine-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 500;
  }

  .difficulty-badge {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 500;
  }

  .prep-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .recipe-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .recipe-section h4 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.5rem 0;
  }

  .recipe-list {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .recipe-list--numbered {
    list-style-type: decimal;
  }

  .recipe-list li {
    margin-bottom: 0.25rem;
  }

  .recipe-note {
    margin: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--line);
    font-style: italic;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .recipe-alchemy {
    background: var(--canvas);
    border: 1px solid var(--line);
    padding: 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    line-height: 1.5;
  }
</style>
