---
interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
  usesKatex?: boolean;
}

const {
  title,
  description,
  ogImagePath = "/avatar.png",
  usesKatex = false,
} = Astro.props;

const canonicalURL =
  Astro.site != null ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageAbs =
  Astro.site != null
    ? new URL(ogImagePath.replace(/^\//, ""), Astro.site).href
    : ogImagePath;

const home = Astro.url.pathname.replace(/\/+$/, "") === "";
const baseName =
  Astro.site != null ? new URL(Astro.site).hostname.replace("www.", "") : "site";
const fullTitle = home ? title : `${title} · ${baseName}`;
const desc = description ?? "";

import { siteConfig } from "../site-config";
import "../styles/global.css";
import AchievementSystem from "../components/AchievementSystem.astro";
import ToastNotification from "../components/ToastNotification.astro";
import NoiseOverlay from "../components/NoiseOverlay.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf5" />
    <script is:inline>
      (function () {
        var t;
        try {
          var stored = localStorage.getItem("theme");
          if (stored) {
            t = stored;
          } else {
            t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
        } catch (_) {
          t = "light";
        }
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute("content", t === "dark" ? "#0a0d1a" : "#fafaf5");
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {desc ? <meta name="description" content={desc} /> : null}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Pablo Olivares — RSS" href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {desc ? <meta property="og:description" content={desc} /> : null}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbs} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {desc ? <meta name="twitter:description" content={desc} /> : null}
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Geist:wght@400;500;600;700&family=VT323&display=optional">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Geist:wght@400;500;600;700&family=VT323&display=optional" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Geist:wght@400;500;600;700&family=VT323&display=optional"></noscript>
    {
      usesKatex && (
        <>
          <link rel="preload" as="style" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" media="print" onload="this.media='all'">
          <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous"></noscript>
        </>
      )
    }

    {
      import.meta.env.PROD && siteConfig.googleAnalyticsId ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalyticsId}`}
          />
          <script is:inline define:vars={{ gaId: siteConfig.googleAnalyticsId }}>
            {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', gaId);`}
          </script>
        </>
      ) : null
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="stars" aria-hidden="true"></div>
    <div class="blueprint-grid" aria-hidden="true"></div>
    <div class="page-wrap">
      <main id="main-content">
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        function meta(t) {
          var m = document.querySelector('meta[name="theme-color"]');
          if (!m) return;
          m.setAttribute("content", t === "dark" ? "#0a0d1a" : "#fafaf5");
        }
        function syncAria() {
          var th = document.documentElement.dataset.theme === "light" ? "light" : "dark";
          document.querySelectorAll("[data-theme-set]").forEach(function (btn) {
            btn.setAttribute("aria-pressed", btn.getAttribute("data-theme-set") === th ? "true" : "false");
          });
          document.querySelectorAll("[data-theme-cycle]").forEach(function (btn) {
            btn.setAttribute("aria-pressed", th === "dark" ? "true" : "false");
          });
        }
        function apply(raw) {
          var th = raw === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = th;
          meta(th);
          try {
            localStorage.setItem("theme", th);
          } catch {}
          syncAria();
          document.dispatchEvent(new CustomEvent("site-theme", { detail: { theme: th } }));
        }
        document.addEventListener("click", function (ev) {
          var cy = ev.target && ev.target.closest && ev.target.closest("[data-theme-cycle]");
          if (cy) {
            ev.preventDefault();
            apply(document.documentElement.dataset.theme === "light" ? "dark" : "light");
            return;
          }
          var n = ev.target && ev.target.closest && ev.target.closest("[data-theme-set]");
          if (!n) return;
          ev.preventDefault();
          apply(n.getAttribute("data-theme-set") || "dark");
        });
        window.addEventListener("keydown", function (ev) {
          if (!ev.altKey || ev.repeat) return;
          if (String(ev.key).toLowerCase() !== "t") return;
          ev.preventDefault();
          apply(document.documentElement.dataset.theme === "light" ? "dark" : "light");
        });
        meta(document.documentElement.dataset.theme || "dark");
        syncAria();
        document.dispatchEvent(
          new CustomEvent("site-theme", { detail: { theme: document.documentElement.dataset.theme || "dark" } })
        );
      })();
    </script>
    <NoiseOverlay />
    <AchievementSystem />
    <ToastNotification />
  </body>
</html>
